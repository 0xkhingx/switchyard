# --->8---
# Switchyard local dev overrides. Copy to `.env` and fill in.
# Never commit `.env`.
DATABASE_URL=postgres://switchyard:switchyard@localhost:5432/switchyard
DASHBOARD_ORIGIN=http://localhost:3000
PORT=8080
# Session cookie Secure flag. Defaults to on when DASHBOARD_ORIGIN is https://
# and off for http:// (so local http://localhost dev works unchanged).
# Set to true/1 or false/0 to override.
# COOKIE_SECURE=
